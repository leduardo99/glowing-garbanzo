# Database (integration test harness — dedicated test database, never the dev db)
DATABASE_URL="postgresql://roteiros:roteiros@localhost:5432/itineraries_test"

# Better Auth (unused by the test harness itself, kept for parity with .env.local)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=test-secret-not-for-production

# AI generator (provider is module-mocked in tests; the key only needs to be present
# so `generateItineraryDraftImpl` gets past its key-configured guard)
GEMINI_API_KEY=test-gemini-key-not-real
