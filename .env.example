# Database
DATABASE_URL="postgresql://roteiros:roteiros@localhost:5432/roteiros"

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate a secret key: `pnpm dlx @better-auth/cli secret`
BETTER_AUTH_SECRET=

# Uploads
# Directory where uploaded files (e.g. cover images) are stored on disk.
# Defaults to ./uploads when unset.
UPLOADS_DIR=
# Vercel Blob read/write token. When set, cover-image uploads go to Vercel
# Blob storage instead of disk (needed on Vercel — see DEPLOY.md). Leave
# unset for local dev / non-Vercel deployments.
BLOB_READ_WRITE_TOKEN=
